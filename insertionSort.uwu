fn insertionSort(arr: array[int]) -> array[int] {
    var sorted: array[int] = arr;
    var i = 1;
    while i < 30 {
        var key = sorted[i];
        var j = i - 1;
        while (j >= 0) and (sorted[j] > key) {
            sorted[j + 1] = sorted[j];
            j = j - 1;
        }
        sorted[j + 1] = key;
        i = i + 1;
    }
    return sorted;
}

let numbers: array[int] = [64, 34, 25, 12, 22, 11, 90, 5, 77, 33, 1, 99, 45, 23, 8, 67, 19, 88, 3, 56, 42, 71, 14, 60, 29, 95, 6, 81, 37, 50];

let result = insertionSort(numbers);

var i = 0;
while i < 30 {
    print("{} ", result[i]);
    i = i + 1;
}
println("");