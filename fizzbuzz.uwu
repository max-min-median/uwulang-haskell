var i = 0;
let n = 100;

let fizzbuzz = solution(n);

while i  < n {
    print("{}", fizzbuzz[i]);
    i += 1;
}

fn solution(n: int) -> array[str] {
    var result: array[str] = [];

    var i = 1;
    while i <= n {
        if i % 5 == 0 and i % 3 == 0 {
            result.push("fizzbuzz");
        } else if i % 3 == 0 {
            result.push("fizz");
        } else if i % 5 == 0 {
            result.push("buzz");
        } else { result.push(format("{}", i)); }
          i += 1;
    }
    return result;
}