fn quicksort(arr: array[int]) {
    fn quicksortHelper(lo: int, hi: int) {
        if lo >= hi {
            return;
        }

        let pivot = arr[hi];
        var i = lo - 1;
        var j = lo;
        while j < hi {
            if arr[j] < pivot {
                i = i + 1;
                let temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
        let temp = arr[i];
        arr[i] = arr[hi];
        arr[hi] = temp;

        quicksortHelper(lo, i - 1);
        quicksortHelper(i + 1, hi);
    }

    quicksortHelper(0, len(arr) - 1);
}

var numbers: array[int] = [
    83, 12, 47, 91, 3, 56, 29, 74, 8, 65,
    40, 17, 99, 22, 61, 5, 88, 34, 71, 19,
    50, 6, 93, 27, 45, 79, 14, 62, 38, 84,
    2, 58, 31, 96, 11, 69, 44, 25, 77, 9,
    53, 86, 20, 67, 4, 92, 36, 15, 81, 60,
    28, 73, 7, 49, 90, 33, 66, 18, 55, 41,
    97, 23, 70, 1, 87, 30, 63, 13, 76, 42,
    89, 26, 59, 10, 95, 37, 64, 21, 80, 46,
    54, 68, 0, 94, 16, 39, 82, 24, 57, 98,
    35, 72, 43, 85, 32, 51, 78, 48, 75, 52
];
quicksort(numbers);

var i = 0;
while i < len(numbers) {
    print("{} ", numbers[i]);
    i = i + 1;
}
